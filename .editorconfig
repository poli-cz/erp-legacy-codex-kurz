# Kódování a styl. Proč UTF-8 s BOM: docs/KODOVANI.md
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csproj,props,sql}]
charset = utf-8-bom

[*.{slnx,json,yml,yaml,md,toml}]
indent_size = 2

# Výjimka: soubor je ve Windows-1250 a s CRLF. EditorConfig neumí charset windows-1250,
# proto zde charset úmyslně chybí; editor ho nesmí přeuložit. Viz docs/KODOVANI.md.
[src/Erp.Payroll/StareKonstanty.cs]
charset = unset
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = unset
